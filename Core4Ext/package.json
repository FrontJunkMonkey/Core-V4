{
  "name": "core4-extension",
  "displayName": "Core4 CSS Framework",
  "description": "Automatically generates optimized CSS for the Core4 framework based on classes used in your HTML files",
  "version": "0.3.0",
  "publisher": "FrontJunkMonkey",
  "author": {
    "name": "FrontJunkMonkey"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/FrontJunkMonkey/Core-V4.git"
  },
  "bugs": {
    "url": "https://github.com/FrontJunkMonkey/Core-V4/issues"
  },
  "homepage": "https://github.com/FrontJunkMonkey/Core-V4#readme",
  "keywords": [
    "css",
    "framework", 
    "utility-first",
    "core4",
    "responsive",
    "layout",
    "generator",
    "productivity"
  ],
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "Other",
    "Formatters", 
    "Snippets"
  ],
  "galleryBanner": {
    "color": "#008001",
    "theme": "dark"
  },
  "icon": "assets/icon.png",
  "activationEvents": [
    "onStartupFinished",
    "onCommand:core4.generateCSS",
    "onCommand:core4.openSettings"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "core4.generateCSS",
        "title": "Generate CSS",
        "category": "Core4",
        "icon": "$(refresh)"
      },
      {
        "command": "core4.toggleWatching",
        "title": "Toggle File Watching",
        "category": "Core4",
        "icon": "$(eye)"
      },
      {
        "command": "core4.openSettings",
        "title": "Open Settings",
        "category": "Core4",
        "icon": "$(settings-gear)"
      },
      {
        "command": "core4.openOutput",
        "title": "Open CSS Output File",
        "category": "Core4",
        "icon": "$(file-code)"
      },
      {
        "command": "core4.showStats",
        "title": "Show Statistics",
        "category": "Core4",
        "icon": "$(graph)"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "core4.generateCSS",
          "when": "workspaceFolderCount > 0"
        },
        {
          "command": "core4.toggleWatching",
          "when": "workspaceFolderCount > 0"
        },
        {
          "command": "core4.openSettings",
          "when": "workspaceFolderCount > 0"
        },
        {
          "command": "core4.openOutput",
          "when": "workspaceFolderCount > 0"
        },
        {
          "command": "core4.showStats",
          "when": "workspaceFolderCount > 0"
        }
      ]
    },
    "configuration": {
      "title": "Core4 Extension",
      "properties": {
        "core4.enabled": {
          "type": "boolean",
          "default": false,
          "description": "Enable Core4 CSS generation for this project"
        },
        "core4.outputPath": {
          "type": "string",
          "default": "./styles/core4.css",
          "description": "Path where generated CSS will be saved"
        },
        "core4.minify": {
          "type": "boolean",
          "default": true,
          "description": "Minify the generated CSS"
        },
        "core4.includeDefaultStyles": {
          "type": "boolean",
          "default": true,
          "description": "Include default element styles (buttons, inputs, etc.) - disable for existing websites"
        },
        "core4.primaryColor": {
          "type": "string",
          "default": "#008001",
          "description": "Primary brand color (used for buttons, links, etc.)"
        },
        "core4.secondaryColor": {
          "type": "string",
          "default": "#005500",
          "description": "Secondary brand color (used for hover states, etc.)"
        },
        "core4.highlightColor": {
          "type": "string",
          "default": "#ff6b35",
          "description": "Highlight/accent color"
        },
        "core4.fontFamily": {
          "type": "string",
          "default": "-apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, sans-serif",
          "description": "Default font family for the project"
        },
        "core4.baseFontSize": {
          "type": "string",
          "default": "16px",
          "description": "Base font size for the project"
        },
        "core4.borderRadius": {
          "type": "string",
          "default": "0.35em",
          "description": "Default border radius"
        },
        "core4.shadowColor": {
          "type": "string",
          "default": "rgba(0,0,0,0.1)",
          "description": "Default shadow color"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "echo \"No tests specified\" && exit 0"
  },
  "devDependencies": {
    "@types/node": "16.x",
    "@types/vscode": "^1.74.0",
    "typescript": "^4.9.5"
  }
}
